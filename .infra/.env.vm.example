# Copy to .infra/.env.vm (ignored). Never use the local development credentials.
# Generate passwords with `openssl rand -hex 32` (safe in URLs).
POSTGRES_USER=jiroo_owner
POSTGRES_PASSWORD=
POSTGRES_DB=jiroo
# Both URLs use the Compose service `db`, not localhost or a cloud host.
DIRECT_DATABASE_URL=
DATABASE_URL=
JIROO_RUNTIME_ROLE=jiroo_runtime
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://jiroo.example.invalid
APP_PORT=3000
# Fill from the release manifest. Prefer @sha256:... digests.
JIROO_IMAGE=
