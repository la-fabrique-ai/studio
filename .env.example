# Local template used by `pnpm env:setup`; see .infra/README.md.
# Local Docker only. Keep credentials/port in these URLs aligned with POSTGRES_*.
POSTGRES_USER=jiroo
POSTGRES_PASSWORD=jiroo
POSTGRES_DB=jiroo
POSTGRES_PORT=5434
DATABASE_URL=postgres://jiroo:jiroo@127.0.0.1:5434/jiroo
DIRECT_DATABASE_URL=postgres://jiroo:jiroo@127.0.0.1:5434/jiroo

# better-auth
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Seed admin (created by pnpm db:seed)
SEED_ADMIN_EMAIL=admin@cassation.fr
